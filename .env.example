# 퓨처나우 진단 플랫폼 — 환경변수 예시
#
# 쓰는 법: 이 파일을 `.env.local` 로 복사하고 값을 채운다. **값은 지휘부에게 받는다** —
#   저장소·보고서·커밋 어디에도 값을 싣지 않는다(`.gitignore` 가 `.env*` 를 막는다 · CLAUDE §10).
#
# 키 목록은 **추측이 아니라 실측이다** — 저장소에서 그 이름을 읽는 곳이 있는 키만 적었다.
#   다시 재는 법: `grep -rl "<키>" src scripts tests next.config.ts vercel.json`
#
# SAIL 과 동일 Supabase 프로젝트를 공유한다(architecture §3 · CLAUDE §5).

# ── ⑴ 앱 구동에 필요하다(개발 서버·빌드) ─────────────────────────────────────
# 브라우저에 노출돼도 되는 값만 NEXT_PUBLIC_ 접두사를 쓴다. 그 밖의 비밀에는 절대 붙이지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── ⑵ 검증 도구에 필요하다(없으면 그 도구만 못 돈다 — 앱 구동과 무관) ────────
# 실DB 직결 — 마이그레이션 예행·적용, 실측 질의, 실DB 통합 테스트(RUN_RLS_INTEGRATION=1).
#   운영 DB 이므로 **쓰기는 트랜잭션 롤백 안에서만**, 실기수 데이터는 읽기만 한다(CLAUDE §10 · 불변식 18).
SUPABASE_DB_URL=

# 서버 전용 키 — 일부 계측 스크립트(공개 사진 프록시·업로드 상한 탐침)가 쓴다. 앱 런타임은 쓰지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# QA 상주 계정 셋 — 실브라우저 검증(로그인 뒤 화면)에 쓴다. 실기수·실참여자 계정을 쓰지 않기 위한 자산이다.
#   `docs/reports/README.md` 의 「상주 QA 계정은 픽스처 잔여 0 의 명시적 예외」 참조.
QA_USER_EMAIL=
QA_USER_PASSWORD=
QA_COACH_EMAIL=
QA_COACH_PASSWORD=
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# QA 기수 코드 — 실화면 검증이 어느 회기에서 도는지. 실기수 코드를 넣지 않는다.
QA_COHORT_CODE=

# ── 참고: 저장소 코드가 읽지 않는 키 ──────────────────────────────────────────
# 로컬 `.env.local` 에 아래가 들어 있을 수 있으나 **이 저장소는 한 곳에서도 읽지 않는다**(실측).
#   없다고 해서 무엇이 깨지지 않는다 — 다른 도구·옛 설정의 흔적이다.
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY · NEXT_PUBLIC_SUPABASE_PROJECT_REF
#   NEXT_PUBLIC_BASE_URL · SUPABASE_SECRET_KEY
